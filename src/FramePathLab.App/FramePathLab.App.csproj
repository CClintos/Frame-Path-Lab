<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FramePathLab.App</RootNamespace>
    <AssemblyName>FramePathLab</AssemblyName>
    <Product>FramePath Lab</Product>
    <Description>Evidence-led competitive FPS readiness scanner with one bounded reversible Windows experiment</Description>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FramePathLab.Core/FramePathLab.Core.csproj" />
    <ProjectReference Include="../FramePathLab.Windows/FramePathLab.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="DistributionReadme.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../samples/presentmon-sample.csv" Link="samples/presentmon-sample.csv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
